{
  "$comment": [
    "The single source of truth for HealthHub's design language (Constitution Principle III).",
    "build.mjs generates web/src/core/m3e/generated-tokens.css and the Android GeneratedTokens.kt",
    "from this file. Never edit either generated artefact — edit this and rebuild.",
    "",
    "The chart series palette is the validated reference palette from the data-viz method,",
    "re-validated against HealthHub's own surfaces: light #FFF8F5 and dark #1A120D.",
    "Light mode reports three slots below 3:1 contrast (aqua, yellow, magenta), which obliges",
    "the relief rule — the activity detail screen ships direct value labels and a splits table,",
    "so identity is never carried by colour alone.",
    "",
    "Colour-vision deficiency: measured, not assumed. contrast.test.ts simulates protanopia,",
    "deuteranopia and tritanopia and reports the pairwise CIELAB separation of the eight slots.",
    "Light clears ΔE 10 on every pair. Dark does not: slot 1 against slot 7 collapses to ΔE 2.5",
    "under protanopia, and slot 3 against slot 5 to ΔE 4.7 under deuteranopia. Eight categorical",
    "hues cannot all survive three simulations, which is exactly why the relief rule exists —",
    "every channel gets its own panel, its own name and its own value readout. The weak pairs",
    "are pinned in the test, so a change that adds a ninth collision fails rather than passes."
  ],
  "meta": {
    "name": "HealthHub Expressive",
    "version": 1,
    "system": "Material 3 Expressive",
    "seed": "#E8590C"
  },

  "color": {
    "light": {
      "primary": "#9A4A00",
      "onPrimary": "#FFFFFF",
      "primaryContainer": "#FFDCC2",
      "onPrimaryContainer": "#321300",
      "secondary": "#755846",
      "onSecondary": "#FFFFFF",
      "secondaryContainer": "#FFDCC2",
      "onSecondaryContainer": "#2B1709",
      "tertiary": "#4F6442",
      "onTertiary": "#FFFFFF",
      "tertiaryContainer": "#D1EABE",
      "onTertiaryContainer": "#0D2005",
      "error": "#BA1A1A",
      "onError": "#FFFFFF",
      "errorContainer": "#FFDAD6",
      "onErrorContainer": "#410002",
      "background": "#FFF8F5",
      "onBackground": "#211A15",
      "surface": "#FFF8F5",
      "onSurface": "#211A15",
      "surfaceVariant": "#F3DFD1",
      "onSurfaceVariant": "#52443A",
      "surfaceContainerLowest": "#FFFFFF",
      "surfaceContainerLow": "#FFF1E8",
      "surfaceContainer": "#FCEBE1",
      "surfaceContainerHigh": "#F6E5DC",
      "surfaceContainerHighest": "#F1DFD6",
      "surfaceDim": "#E5D5CB",
      "surfaceBright": "#FFF8F5",
      "outline": "#857269",
      "outlineVariant": "#D7C2B8",
      "inverseSurface": "#372F2A",
      "inverseOnSurface": "#FDEEE6",
      "inversePrimary": "#FFB77C",
      "scrim": "#000000",
      "shadow": "#000000"
    },
    "dark": {
      "primary": "#FFB77C",
      "onPrimary": "#522300",
      "primaryContainer": "#753500",
      "onPrimaryContainer": "#FFDCC2",
      "secondary": "#E4BFA8",
      "onSecondary": "#422B1C",
      "secondaryContainer": "#5B4130",
      "onSecondaryContainer": "#FFDCC2",
      "tertiary": "#B5CEA3",
      "onTertiary": "#223618",
      "tertiaryContainer": "#384D2C",
      "onTertiaryContainer": "#D1EABE",
      "error": "#FFB4AB",
      "onError": "#690005",
      "errorContainer": "#93000A",
      "onErrorContainer": "#FFDAD6",
      "background": "#1A120D",
      "onBackground": "#F1DFD6",
      "surface": "#1A120D",
      "onSurface": "#F1DFD6",
      "surfaceVariant": "#52443A",
      "onSurfaceVariant": "#D7C2B8",
      "surfaceContainerLowest": "#120B07",
      "surfaceContainerLow": "#231A15",
      "surfaceContainer": "#271E18",
      "surfaceContainerHigh": "#322822",
      "surfaceContainerHighest": "#3D332C",
      "surfaceDim": "#1A120D",
      "surfaceBright": "#423731",
      "outline": "#9F8D83",
      "outlineVariant": "#52443A",
      "inverseSurface": "#F1DFD6",
      "inverseOnSurface": "#372F2A",
      "inversePrimary": "#9A4A00",
      "scrim": "#000000",
      "shadow": "#000000"
    }
  },

  "chart": {
    "$comment": [
      "Categorical slots are assigned in fixed order and never cycled. A channel keeps its",
      "slot regardless of how many series are visible, so filtering never repaints survivors.",
      "A ninth channel does not get a generated hue — it folds into a facet."
    ],
    "series": {
      "light": [
        "#2a78d6",
        "#eb6834",
        "#1baf7a",
        "#eda100",
        "#e87ba4",
        "#008300",
        "#4a3aa7",
        "#e34948"
      ],
      "dark": [
        "#3987e5",
        "#d95926",
        "#199e70",
        "#c98500",
        "#d55181",
        "#008300",
        "#9085e9",
        "#e66767"
      ]
    },
    "channelSlots": {
      "speed": 0,
      "hr": 1,
      "elevation": 2,
      "cadence": 3,
      "power": 4,
      "grade": 5,
      "temperature": 6,
      "hrv": 7
    },
    "sequential": {
      "$comment": "Single hue, light→dark. Used for magnitude overlays such as route colouring.",
      "hue": "blue",
      "steps": [
        "#cde2fb",
        "#b7d3f6",
        "#9ec5f4",
        "#86b6ef",
        "#6da7ec",
        "#5598e7",
        "#3987e5",
        "#2a78d6",
        "#256abf",
        "#1c5cab",
        "#184f95",
        "#104281",
        "#0d366b"
      ],
      "$bounds": [
        "The usable span on each surface, measured against the track an ordinal bar is drawn on",
        "(surfaceContainerHighest) rather than against the page. Below step 8 on light, and above",
        "step 7 on dark, a zone bar falls under 3:1 against its own track and reads as empty."
      ],
      "ordinalFloorLight": 8,
      "ordinalCeilingDark": 7
    },
    "diverging": {
      "$comment": "Two hues plus a neutral midpoint. Used for pace-vs-average and grade.",
      "negative": "#2a78d6",
      "positive": "#e34948",
      "midpoint": { "light": "#f0efec", "dark": "#383835" }
    },
    "status": {
      "$comment": [
        "Per appearance, like the chrome above. A single set cannot serve both: amber and coral",
        "reach 3:1 against a near-black surface and 1.75:1 against a near-white one, so the light",
        "values are the darkened forms of the same four hues."
      ],
      "light": {
        "good": "#0a8f0a",
        "warning": "#b07800",
        "serious": "#c2542a",
        "critical": "#d03b3b"
      },
      "dark": {
        "good": "#0ca30c",
        "warning": "#fab219",
        "serious": "#ec835a",
        "critical": "#d03b3b"
      }
    },
    "chrome": {
      "$comment": [
        "inkMuted is axis tick labels — text, at 4.5:1, not a 3:1 graphic. It used to be the",
        "same value as the `outline` UI role, which clears 3:1 and lands at 4.34:1 against the",
        "light surface. The two have different jobs and now have different values."
      ],
      "light": {
        "surface": "#FFF8F5",
        "inkPrimary": "#211A15",
        "inkSecondary": "#52443A",
        "inkMuted": "#7B6860",
        "gridline": "#EADACF",
        "axis": "#D7C2B8"
      },
      "dark": {
        "surface": "#1A120D",
        "inkPrimary": "#F1DFD6",
        "inkSecondary": "#D7C2B8",
        "inkMuted": "#9F8D83",
        "gridline": "#2E251F",
        "axis": "#52443A"
      }
    },
    "marks": {
      "$comment": "Mark geometry from the data-viz method: thin marks, rounded data ends, gaps between fills.",
      "lineWidth": 2,
      "markerMinSize": 8,
      "dataEndRadius": 4,
      "fillGap": 2,
      "overlapRing": 2
    }
  },

  "shape": {
    "none": 0,
    "extraSmall": 4,
    "small": 8,
    "medium": 12,
    "large": 16,
    "largeIncreased": 20,
    "extraLarge": 28,
    "extraLargeIncreased": 32,
    "extraExtraLarge": 48,
    "full": 9999
  },

  "typography": {
    "$comment": "Material 3 Expressive type scale. 'Emphasized' roles carry the heavier weight the Expressive spec uses for prominence.",
    "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "scale": {
      "displayLarge": { "size": 57, "lineHeight": 64, "weight": 400, "tracking": -0.25 },
      "displayMedium": { "size": 45, "lineHeight": 52, "weight": 400, "tracking": 0 },
      "displaySmall": { "size": 36, "lineHeight": 44, "weight": 400, "tracking": 0 },
      "headlineLarge": { "size": 32, "lineHeight": 40, "weight": 400, "tracking": 0 },
      "headlineMedium": { "size": 28, "lineHeight": 36, "weight": 400, "tracking": 0 },
      "headlineSmall": { "size": 24, "lineHeight": 32, "weight": 400, "tracking": 0 },
      "titleLarge": { "size": 22, "lineHeight": 28, "weight": 400, "tracking": 0 },
      "titleMedium": { "size": 16, "lineHeight": 24, "weight": 500, "tracking": 0.15 },
      "titleSmall": { "size": 14, "lineHeight": 20, "weight": 500, "tracking": 0.1 },
      "bodyLarge": { "size": 16, "lineHeight": 24, "weight": 400, "tracking": 0.5 },
      "bodyMedium": { "size": 14, "lineHeight": 20, "weight": 400, "tracking": 0.25 },
      "bodySmall": { "size": 12, "lineHeight": 16, "weight": 400, "tracking": 0.4 },
      "labelLarge": { "size": 14, "lineHeight": 20, "weight": 500, "tracking": 0.1 },
      "labelMedium": { "size": 12, "lineHeight": 16, "weight": 500, "tracking": 0.5 },
      "labelSmall": { "size": 11, "lineHeight": 16, "weight": 500, "tracking": 0.5 },
      "displayLargeEmphasized": { "size": 57, "lineHeight": 64, "weight": 500, "tracking": -0.25 },
      "headlineLargeEmphasized": { "size": 32, "lineHeight": 40, "weight": 600, "tracking": 0 },
      "headlineMediumEmphasized": { "size": 28, "lineHeight": 36, "weight": 600, "tracking": 0 },
      "titleLargeEmphasized": { "size": 22, "lineHeight": 28, "weight": 600, "tracking": 0 },
      "titleMediumEmphasized": { "size": 16, "lineHeight": 24, "weight": 700, "tracking": 0.15 },
      "labelLargeEmphasized": { "size": 14, "lineHeight": 20, "weight": 700, "tracking": 0.1 }
    },
    "numeric": {
      "$comment": "Proportional figures for hero numbers; tabular only where columns must align.",
      "tabularContexts": ["splitsTable", "axisTicks", "statTable"]
    }
  },

  "motion": {
    "$comment": "Material 3 Expressive motion scheme — spring based, not duration based. Spatial springs move things; effects springs change properties like colour and opacity.",
    "spatial": {
      "fast": { "damping": 0.9, "stiffness": 1400 },
      "default": { "damping": 0.9, "stiffness": 700 },
      "slow": { "damping": 0.9, "stiffness": 300 }
    },
    "effects": {
      "fast": { "damping": 1.0, "stiffness": 3800 },
      "default": { "damping": 1.0, "stiffness": 1600 },
      "slow": { "damping": 1.0, "stiffness": 800 }
    },
    "cssFallback": {
      "$comment": "CSS has no spring primitive; these easings approximate the springs above for the web layer.",
      "spatialFast": "cubic-bezier(0.05, 0.7, 0.1, 1.0) 180ms",
      "spatialDefault": "cubic-bezier(0.05, 0.7, 0.1, 1.0) 320ms",
      "spatialSlow": "cubic-bezier(0.05, 0.7, 0.1, 1.0) 520ms",
      "effectsFast": "cubic-bezier(0.3, 0, 0.8, 0.15) 120ms",
      "effectsDefault": "cubic-bezier(0.3, 0, 0.8, 0.15) 220ms",
      "effectsSlow": "cubic-bezier(0.3, 0, 0.8, 0.15) 380ms"
    }
  },

  "spacing": {
    "none": 0,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "xxxl": 48
  },

  "elevation": {
    "level0": 0,
    "level1": 1,
    "level2": 3,
    "level3": 6,
    "level4": 8,
    "level5": 12
  }
}
