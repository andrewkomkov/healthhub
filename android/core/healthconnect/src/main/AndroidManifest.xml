<?xml version="1.0" encoding="utf-8"?>
<!--
  Every Health Connect permission the record registry can request, declared by the module that
  owns the registry.

  Declaring is not asking. A permission must be in the merged manifest before it can ever be
  requested, but *when* it is requested is decided at run time by HealthFeatures: a fresh
  install asks for the workout domain only, and sleep, recovery, body composition and blood
  pressure are requested at the moment the athlete switches them on (Constitution Principle IV).
  So this list is the app's ceiling, not its opening offer.

  Adding a RegisteredRecord to HealthRecordRegistry without adding its permission here produces
  a request that silently cannot be granted — the same failure mode READ_EXERCISE_ROUTE had.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Workouts. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <!--
      Two route permissions exist and only one of them is a dead end. Singular
      READ_EXERCISE_ROUTE is prot=signature, owned by
      com.google.android.healthconnect.controller, and stays out of this file for good.

      Plural READ_EXERCISE_ROUTES is prot=dangerous and is the one the per-activity flow
      needs — not to be *granted*, but to be *declared*. RouteRequestActivity checks the
      caller's manifest before it draws anything, and an app that has not declared it gets
      `E RouteRequestActivity: Read permission not declared` in logcat and an immediate
      RESULT_CANCELED: no dialog, no error, and a screen that says the route was not shared.
      It is deliberately absent from HealthConnectSource.requiredPermissions, so the athlete
      is still asked per workout and this never becomes a bulk-GPS request.
    -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE_ROUTES" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SPEED" />
    <uses-permission android:name="android.permission.health.READ_POWER" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ELEVATION_GAINED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <!-- StepsCadenceRecord reads under READ_STEPS; step counts themselves are not ingested. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <!-- Sleep. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!-- Recovery. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />

    <!-- Body composition. -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />

    <!-- Blood pressure. -->
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />

    <!-- Applies to every read above: scheduled sync, and history older than 30 days. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!-- Required so the app can see the Health Connect provider on Android 13 and below. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>
</manifest>
