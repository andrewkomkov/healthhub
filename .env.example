# HealthHub environment — TEMPLATE. Copy to .env.local and fill in.
#
# .env.local is git-ignored and holds the real values. This file is committed and must
# never contain a secret: it exists so a new contributor (or a new agent session) knows
# what exists, where it lives, and how to obtain it.
#
#   cp .env.example .env.local
#
# Nothing here is read automatically by the app. Runtime secrets live in Wrangler secrets
# and GitHub Actions secrets; this file is a map of where things are, for humans and agents.

# ─── Deployment ───────────────────────────────────────────────────────────────
# The live Worker. Serves both the API (/api/*) and the web SPA.
HEALTHHUB_BASE_URL=https://healthhub.andrew-komkov.workers.dev

# ─── Cloudflare ───────────────────────────────────────────────────────────────
# Account id: `npx wrangler whoami`
CLOUDFLARE_ACCOUNT_ID=

# D1 database. Id is also committed in worker/wrangler.jsonc — it is an identifier, not a
# secret. `npx wrangler d1 list`
CLOUDFLARE_D1_NAME=healthhub
CLOUDFLARE_D1_ID=

# R2 bucket for telemetry blobs. `npx wrangler r2 bucket list`
CLOUDFLARE_R2_BUCKET=healthhub-data

# API token for CI deploys. Create at
# https://dash.cloudflare.com/profile/api-tokens with the "Edit Cloudflare Workers"
# template, plus D1:Edit. Store it in GitHub → Settings → Secrets → Actions as
# CLOUDFLARE_API_TOKEN. Local deploys use the wrangler OAuth login instead and need nothing.
CLOUDFLARE_API_TOKEN=

# ─── Auth0 (optional identity provider) ───────────────────────────────────────
# The app works without these: local password accounts are always available, so a fork can
# be deployed without registering anywhere. With them, "Continue with Auth0" appears.
#
# Application type must be **Regular Web Application** — this flow uses a client secret.
# Allowed Callback URLs:
#   https://<worker>.workers.dev/api/auth/auth0/callback
#   http://localhost:8787/api/auth/auth0/callback
# Allowed Logout URLs:  https://<worker>.workers.dev/
# Allowed Web Origins:  https://<worker>.workers.dev
#
# Google sign-in is the google-oauth2 social connection, enabled in the tenant.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Upload to the Worker (these are the values the running Worker actually reads):
#   npx wrangler secret put AUTH0_DOMAIN --config worker/wrangler.jsonc
#   npx wrangler secret put AUTH0_CLIENT_ID --config worker/wrangler.jsonc
#   npx wrangler secret put AUTH0_CLIENT_SECRET --config worker/wrangler.jsonc

# ─── Worker secrets ───────────────────────────────────────────────────────────
# Mixed into session and device token hashing, so a leaked D1 snapshot cannot be used to
# pre-compute token hashes. Any random 32+ bytes; rotating it signs everyone out.
#   openssl rand -base64 48 | npx wrangler secret put SESSION_PEPPER --config worker/wrangler.jsonc
SESSION_PEPPER=

# ─── SonarQube Cloud ──────────────────────────────────────────────────────────
# Project andrewkomkov_healthhub. The token lives only in GitHub Actions secrets.
SONAR_TOKEN=

# ─── Test devices ─────────────────────────────────────────────────────────────
# `adb devices -l`. Install with --user 0 (secondary profiles exist on both) and NEVER
# with -g — see docs/AGENT-NOTES.md, it silently breaks Health Connect permission requests.
ANDROID_DEVICE_PIXEL=38041FDJH006G1
ANDROID_DEVICE_SAMSUNG=RZ8R21EG0DJ
ANDROID_SDK_ROOT=$HOME/Library/Android/sdk
