# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Cloudflare
.wrangler/
.dev.vars
.dev.vars.*

# Android / Gradle
android/.gradle/
# build-logic is its own Gradle build, so it has its own caches and lock files.
# They churn on every invocation and were tracked by accident.
android/build-logic/.gradle/
android/build/
android/*/build/
android/*/*/build/
android/local.properties
android/.idea/
android/captures/
*.apk
*.aab
*.keystore
!android/gradle/wrapper/gradle-wrapper.jar

# Generated design tokens (built from packages/design-tokens/tokens.json)
android/core/designsystem/src/main/kotlin/dev/healthhub/core/designsystem/GeneratedTokens.kt
web/src/core/m3e/generated-tokens.css

# Test output
playwright-report/
test-results/
coverage/

# Editors / OS
.DS_Store
.idea/
*.iml
.vscode/

# Agent working files — may contain credentials
.claude/settings.local.json

# Source PRD is marked confidential; its content is captured in specs/ instead
google_health_strava_prd.pdf

# Auth provider credentials — never commit
.env.auth
.env
.env.*
!.env.example

# Gradle wrapper jar is committed on purpose (reproducible builds); local SDK path is not
android/local.properties

# The Android release signing identity. An APK signed with a different key will not install
# over one signed with this one, so the keystore is kept out of the repository and backed up
# by hand — losing it means every existing install has to be uninstalled before an update.
.keys/
*.jks
*.keystore
